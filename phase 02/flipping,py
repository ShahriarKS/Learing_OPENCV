
#flip
# variable = cv2. flip(kon image , flipcode)
#flipcode = 0 vertically
#         = 1 horizontally
#         = -1 vertically and horizontally

import cv2

img= cv2.imread("imageFolder/flower.jpg")

flipped_horizontal = cv2.flip(img,0)
flipped_vertical = cv2. flip(img ,1)

cv2.imshow("original", img)
cv2.imshow("flippedH",flipped_horizontal)
cv2.imshow("flippedV",flipped_vertical)

cv2.waitKey(0)
cv2.destroyAllWindows()
